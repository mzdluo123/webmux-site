{
  "name": "webmux-site",
  "version": "0.0.0",
  "private": true,
  "description": "WebMux 官网：营销页、下载与安装、文档镜像",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch-releases": "node scripts/fetch-releases.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "build": "node scripts/fetch-releases.mjs && astro build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --port 8787",
    "check": "astro check",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:links": "node tests/check-links.mjs",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:a11y": "node tests/a11y.mjs",
    "test:lighthouse": "lhci autorun",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.8",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@astrojs/svelte": "9.1.2",
    "@internationalized/date": "3.12.0",
    "@tabler/icons-svelte": "3.50.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "bits-ui": "2.20.3",
    "clsx": "2.1.1",
    "shadcn-svelte": "1.7.2",
    "sharp": "0.35.5",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@types/hast": "3.0.4",
    "@types/sanitize-html": "2.16.0",
    "github-slugger": "2.0.0",
    "html-validate": "11.18.0",
    "marked": "18.1.2",
    "oxfmt": "0.74.0",
    "playwright": "1.64.1",
    "sanitize-html": "2.18.1",
    "typescript": "6.0.3",
    "wrangler": "4.156.1"
  }
}
