---
// Not found (ux.md#反馈与状态): bilingual, served with a real 404 status by the host; links to the
// main entry points and to the docs, where full-text search lives.
import Base from "../layouts/Base.astro";
import { REPO_URL } from "../../site.config.mjs";

const links = [
  { zh: "首页", en: "Home", zhHref: "/", enHref: "/en/" },
  { zh: "下载与安装", en: "Download", zhHref: "/download/", enHref: "/en/download/" },
  { zh: "文档与搜索", en: "Docs and search (Chinese)", zhHref: "/docs/", enHref: "/docs/" },
  { zh: "常见问题", en: "FAQ", zhHref: "/faq/", enHref: "/en/faq/" },
];
const item = "flex min-h-11 items-center rounded-md border bg-page px-4 text-[15px] text-foreground no-underline hover:border-primary";
---

<Base
  lang="zh-cn"
  path="/404/"
  single
  noindex
  title="页面不存在 · WebMux"
  description="你要找的页面不存在或已经移动。可以回到 WebMux 首页、下载与安装页，或者到文档中心用全文搜索查找需要的内容。The page you are looking for does not exist."
>
  <section class="container-site py-16 sm:py-24" aria-labelledby="nf-title">
    <p class="m-0 font-mono text-[13px] text-primary">404</p>
    <h1 id="nf-title" class="mt-3 mb-0 text-[36px] leading-[1.15] font-bold tracking-[-0.02em] sm:text-[48px]">页面不存在</h1>
    <p class="mt-4 mb-0 max-w-[640px] text-[17px] leading-[1.75] text-muted-foreground">
      你访问的地址没有对应的页面，可能已经移动或输入有误。可以从下面的入口继续；要查找具体功能，请到文档中心使用页面顶部的搜索框。
    </p>
    <nav aria-label="站内入口" class="mt-8">
      <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
        {links.map((x) => <li><a class={item} href={x.zhHref}>{x.zh}</a></li>)}
        <li><a class={item} href={REPO_URL} rel="noopener">GitHub<span class="sr-only">（外部链接）</span></a></li>
      </ul>
    </nav>

    <div lang="en" class="mt-14 border-t border-band-line pt-10">
      <h2 class="m-0 text-[26px] leading-[1.25] font-bold">Page not found</h2>
      <p class="mt-3 mb-0 max-w-[640px] text-[17px] leading-[1.6] text-muted-foreground">
        There is no page at this address; it may have moved, or the link may be mistyped. Continue from one of the links
        below. To look up a feature, use the search box at the top of the docs (written in Chinese).
      </p>
      <nav aria-label="Site entry points" class="mt-6">
        <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
          {links.map((x) => <li><a class={item} href={x.enHref}>{x.en}</a></li>)}
          <li><a class={item} href={REPO_URL} rel="noopener">GitHub<span class="sr-only"> (external link)</span></a></li>
        </ul>
      </nav>
    </div>
  </section>
</Base>
