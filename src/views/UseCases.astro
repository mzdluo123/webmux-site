---
// /use-cases/: concrete situations WebMux is built for, led by remote web development on a Linux
// server, plus the cases it is not built for (strategy.md#证据点: boundaries are trust signals).
import IconBrandWindows from "@tabler/icons-svelte/icons/brand-windows";
import IconCpu from "@tabler/icons-svelte/icons/cpu";
import IconDeviceMobile from "@tabler/icons-svelte/icons/device-mobile";
import IconEyeCheck from "@tabler/icons-svelte/icons/eye-check";
import IconFileAnalytics from "@tabler/icons-svelte/icons/file-analytics";
import IconGitBranch from "@tabler/icons-svelte/icons/git-branch";
import IconHeartbeat from "@tabler/icons-svelte/icons/heartbeat";
import IconTerminal2 from "@tabler/icons-svelte/icons/terminal-2";
import IconWorldWww from "@tabler/icons-svelte/icons/world-www";
import { Badge } from "$lib/components/ui/badge/index.js";
import { Button } from "$lib/components/ui/button/index.js";
import PageBreadcrumb from "../components/PageBreadcrumb.astro";
import PortForwardIllo from "../components/PortForwardIllo.astro";
import Shot from "../components/Shot.astro";
import TablerIcon from "../components/TablerIcon.astro";
import Base from "../layouts/Base.astro";
import { notFor, useCases, type UseCaseIcon } from "../data/use-cases";
import { localize, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === "zh-cn";
const l = (p: string) => localize(lang, p);
const cases = useCases(lang);
const [featured, ...rest] = cases;
const icons: Record<UseCaseIcon, unknown> = {
  "world-www": IconWorldWww,
  "device-mobile": IconDeviceMobile,
  "git-branch": IconGitBranch,
  cpu: IconCpu,
  "brand-windows": IconBrandWindows,
  "terminal-2": IconTerminal2,
  "file-analytics": IconFileAnalytics,
  "eye-check": IconEyeCheck,
  heartbeat: IconHeartbeat,
};
const external = (href: string) => /^https?:/.test(href);

const c = zh
  ? {
      title: "使用场景：远程服务器 Web 开发、手机接管 agent 等 · WebMux",
      description:
        "WebMux 的九个使用场景：在远程 Linux 服务器上开发 Web 应用并经端口转发预览、手机上接管 Claude Code 与 Codex、多 agent 并行 worktree、家用工作站长任务、移动端审阅 Diff、Windows WSL 2，以及它不适合的场景。",
      h1: "WebMux 能帮你做什么",
      lead: "会话放在服务端，浏览器、手机和本机终端只是附着上去。下面是它最常见的用法，每一步都对应仓库文档中已有的功能。",
      jump: "跳到场景",
      featuredEyebrow: "重点场景",
      viteTitle: "使用绝对路径的框架（如 Vite、Next.js）",
      viteBody: "在转发设置中改为“保留前缀”，再把 base 设为转发前缀；只用相对路径的服务无需改动。",
      uses: "用到的功能",
      docs: "文档",
      h2NotFor: "它不适合的场景",
      notForLead: "说清边界，帮你少走弯路。",
      final: "想在你的服务器上试试？",
      install: "下载与安装",
      compare: "和其他方案比较",
    }
  : {
      title: "Use cases: remote web dev, agents on mobile · WebMux",
      description:
        "Nine ways to use WebMux: build web apps on a remote Linux server with port-forwarded previews, take over Claude Code and Codex from your phone, parallel agents in worktrees, long jobs on a home workstation, diff review on the go, Windows via WSL 2, and what it is not for.",
      h1: "What WebMux is for",
      lead: "Sessions live on the server; browsers, phones and local terminals attach to them. These are the most common ways to use it, and every step maps to a feature documented in the repository.",
      jump: "Jump to a use case",
      featuredEyebrow: "Featured",
      viteTitle: "Frameworks with absolute paths (Vite, Next.js)",
      viteBody: "Switch the forward to “keep prefix” and set the base to the forward prefix; servers that only use relative paths need no change.",
      uses: "Features used",
      docs: "Docs",
      h2NotFor: "What it is not for",
      notForLead: "Clear limits save you a detour.",
      final: "Want to try it on your server?",
      install: "Download and install",
      compare: "Compare with other tools",
    };
---

<Base lang={lang} path="/use-cases/" title={c.title} description={c.description} active="useCases">
  <div class="container-site pt-16 pb-12 sm:pt-24">
    <PageBreadcrumb lang={lang} items={[{ label: zh ? "使用场景" : "Use cases" }]} />
    <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl">{c.h1}</h1>
    <p class="mt-4 max-w-2xl text-[17px] leading-[1.75] text-muted-foreground">{c.lead}</p>
    <nav aria-label={c.jump} class="mt-8">
      <ul class="m-0 grid list-none gap-2 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {
          cases.map((u) => (
            <li>
              <a href={`#${u.id}`} class="flex min-h-11 items-center gap-3 rounded-md border px-3 py-2 text-[15px] text-foreground no-underline hover:border-primary">
                <TablerIcon icon={icons[u.icon]} class="size-5 shrink-0 text-primary" />
                <span class="min-w-0">{u.title.replace(/[。.]$/, "")}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <!-- Featured: remote web development -->
  <section id={featured.id} class="scroll-mt-20 border-y border-band-line bg-band py-16 sm:py-24" aria-labelledby={`${featured.id}-title`}>
    <div class="container-site grid gap-10 md:grid-cols-12">
      <div class="min-w-0 md:col-span-6">
        <p class="m-0 mb-3 inline-flex items-center gap-2 font-mono text-[13px] text-primary">
          <TablerIcon icon={icons[featured.icon]} class="size-4" />
          {c.featuredEyebrow} · {featured.who}
        </p>
        <h2 id={`${featured.id}-title`} class="m-0 text-[26px] leading-[1.25] font-bold sm:text-[34px]">{featured.title}</h2>
        <p class="mt-4 mb-0 text-[17px] leading-[1.75] text-muted-foreground">{featured.pain}</p>
        <ol class="mt-6 grid list-none gap-4 p-0">
          {
            featured.steps.map((s, i) => (
              <li class="grid grid-cols-[2rem_1fr] gap-3">
                <span class="flex size-8 items-center justify-center rounded-full border bg-page font-mono text-sm font-semibold" aria-hidden="true">{i + 1}</span>
                <p class="m-0 pt-1 text-[15px] leading-[1.7]">
                  {s.text}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="flex min-w-0 flex-col gap-6 md:col-span-6">
        <PortForwardIllo lang={lang} />
        <div class="rounded-lg border bg-page p-4">
          <h3 class="m-0 text-[15px] font-semibold">{c.viteTitle}</h3>
          <p class="mt-1 mb-3 text-[15px] leading-[1.7] text-muted-foreground">{c.viteBody}</p>
          <pre tabindex="0" class="m-0 overflow-x-auto rounded-md bg-band px-3 py-2 font-mono text-[13px]"><code>pnpm vite --base /forward/5173/
# Next.js: next.config.js → basePath: "/forward/3000"</code></pre>
        </div>
        {featured.shot && <Shot name={featured.shot.name} dark={featured.shot.dark} sizes="(max-width: 768px) 100vw, 520px" widths={[480, 800, 1040]} />}
        <div>
          <p class="m-0 text-sm text-muted-foreground">{c.uses}</p>
          <ul class="m-0 mt-2 flex list-none flex-wrap gap-2 p-0">
            {featured.uses.map((u) => <li><Badge variant="secondary">{u}</Badge></li>)}
          </ul>
          <p class="mt-4 mb-0 text-sm">
            {c.docs}:{" "}
            {featured.links.map((d, i) => (
              <>
                {i > 0 && " · "}
                <a class="link" href={d.href} rel={external(d.href) ? "noopener" : undefined}>{d.label}</a>
              </>
            ))}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Other use cases -->
  <div class="container-site flex flex-col gap-16 py-16 sm:gap-24 sm:py-24">
    {
      rest.map((u, i) => (
        <article id={u.id} class="grid scroll-mt-20 items-start gap-6 md:grid-cols-12 md:gap-10" aria-labelledby={`${u.id}-title`}>
          <div class:list={["min-w-0", u.shot ? "md:col-span-6" : "md:col-span-8", u.shot && i % 2 === 1 && "md:order-2"]}>
            <p class="m-0 mb-3 inline-flex items-center gap-2 font-mono text-[13px] text-primary">
              <TablerIcon icon={icons[u.icon]} class="size-4" />
              {u.who}
            </p>
            <h2 id={`${u.id}-title`} class="m-0 text-[24px] leading-[1.3] font-bold sm:text-[30px]">{u.title}</h2>
            <p class="mt-3 mb-0 text-base leading-[1.75] text-muted-foreground">{u.pain}</p>
            <ul class="mt-5 grid list-disc gap-2 pl-5 text-[15px] leading-[1.7]">
              {u.steps.map((s) => (
                <li>
                  {s.text}
                </li>
              ))}
            </ul>
            <ul class="m-0 mt-5 flex list-none flex-wrap gap-2 p-0" aria-label={c.uses}>
              {u.uses.map((x) => <li><Badge variant="secondary">{x}</Badge></li>)}
            </ul>
            <p class="mt-4 mb-0 text-sm">
              {c.docs}:{" "}
              {u.links.map((d, j) => (
                <>
                  {j > 0 && " · "}
                  <a class="link" href={d.href} rel={external(d.href) ? "noopener" : undefined}>{d.label}</a>
                </>
              ))}
            </p>
          </div>
          {u.shot && (
            <div class:list={["min-w-0 md:col-span-6", i % 2 === 1 && "md:order-1"]}>
              {u.shot.name.startsWith("mobile-") ? (
                <div class="flex justify-center">
                  <Shot name={u.shot.name} class="w-[60%] max-w-[300px]" sizes="(max-width: 768px) 60vw, 300px" widths={[300, 600]} />
                </div>
              ) : (
                <Shot name={u.shot.name} dark={u.shot.dark} sizes="(max-width: 768px) 100vw, 520px" widths={[480, 800, 1040]} />
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>

  <section class="border-y border-band-line bg-band py-16 sm:py-24" aria-labelledby="not-for">
    <div class="container-site grid gap-8 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4">
        <h2 id="not-for" class="m-0 text-[26px] leading-[1.25] font-bold sm:text-[30px]">{c.h2NotFor}</h2>
        <p class="mt-3 mb-0 text-muted-foreground">{c.notForLead}</p>
      </div>
      <dl class="m-0 grid gap-5 md:col-span-8">
        {
          notFor(lang).map(([need, answer]) => (
            <div>
              <dt class="font-semibold">{need}</dt>
              <dd class="m-0 mt-1 text-[15px] leading-[1.7] text-muted-foreground">{answer}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="container-site py-16 sm:py-24" aria-labelledby="final-title">
    <h2 id="final-title" class="m-0 text-[26px] leading-[1.25] font-bold sm:text-[34px]">{c.final}</h2>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href={l("/download/")} class="wm-control h-11 px-5 text-[15px] font-semibold">{c.install}</Button>
      <Button href={l("/compare/")} variant="outline" class="wm-control h-11 px-5 text-[15px]">{c.compare}</Button>
    </div>
  </section>
</Base>
