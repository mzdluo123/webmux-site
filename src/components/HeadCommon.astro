---
// Head pieces shared by marketing pages and the Starlight docs: self-hosted fonts, icons, the
// pre-paint theme script, and the optional cookie-free analytics beacon.
import fonts from "../data/fonts.json";

const fontCss = `
@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("${fonts["inter-latin"]}") format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Inter";font-style:normal;font-weight:100 900;font-display:swap;src:url("${fonts["inter-latin-ext"]}") format("woff2");unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:"Maple Mono NF CN";font-style:normal;font-weight:100 500;font-display:swap;src:url("${fonts["maple-400-latin"]}") format("woff2");unicode-range:U+0,U+D,U+20-7E,U+A0-AC,U+AE-FF}
@font-face{font-family:"Maple Mono NF CN";font-style:normal;font-weight:600 900;font-display:swap;src:url("${fonts["maple-700-latin"]}") format("woff2");unicode-range:U+0,U+D,U+20-7E,U+A0-AC,U+AE-FF}
`;
// Cloudflare Web Analytics: no cookies, no personal data (strategy.md#转化漏斗与度量).
const beacon = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<link rel="preload" href={fonts["inter-latin"]} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fontCss} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#111814" media="(prefers-color-scheme: dark)" />
<script is:inline>
  // Before first paint: mark JS, and apply the stored theme or the system one (src/lib/theme.ts).
  (() => {
    const root = document.documentElement;
    root.classList.add("js");
    let t = "";
    try {
      t = localStorage.getItem("starlight-theme") || "";
    } catch {}
    const dark = t === "dark" || (t !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
    root.classList.toggle("dark", dark);
    root.dataset.theme = dark ? "dark" : "light";
  })();
</script>
{
  beacon && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token: beacon })}
    />
  )
}
