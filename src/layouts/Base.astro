---
// Marketing page layout: head (title, description, canonical, hreflang, OG, JSON-LD), header,
// main landmark, footer (seo.md#技术基础, seo.md#元信息与社交卡片).
import "../styles/site.css";
import Footer from "../components/Footer.astro";
import HeadCommon from "../components/HeadCommon.astro";
import Header from "../components/Header.astro";
import { HTML_LANG, localize, OG_LOCALE, UI, type Lang } from "../lib/i18n";
import { REPO_URL, SITE_URL } from "../../site.config.mjs";

interface Props {
  lang: Lang;
  /** Locale-neutral path, e.g. "/download/". */
  path: string;
  title: string;
  description: string;
  ogType?: "website" | "article";
  /** Base name of the OG image in public/og/ (without locale suffix and extension). */
  og?: string;
  ogAlt?: string;
  jsonLd?: object[];
  active?: "story" | "install" | "docs" | "faq";
  installHref?: string;
  /** Set when the page has no counterpart in the other language. */
  single?: boolean;
  /** Error pages: robots noindex, no canonical. */
  noindex?: boolean;
}
const { lang, path, title, description, ogType = "article", og = "default", ogAlt, jsonLd = [], active, installHref, single, noindex } =
  Astro.props;
const t = UI[lang];
const abs = (p: string) => new URL(p, SITE_URL).href;
const canonical = abs(localize(lang, path));
const ogImage = abs(`/og/${og}-${lang}.png`);
const site = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": abs("/#website"),
      name: "WebMux",
      url: abs(localize(lang, "/")),
      inLanguage: HTML_LANG[lang],
      publisher: { "@id": abs("/#org") },
    },
    {
      "@type": "Organization",
      "@id": abs("/#org"),
      name: "WebMux",
      url: abs("/"),
      logo: abs("/apple-touch-icon.png"),
      sameAs: [REPO_URL],
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !single && (
        <>
          <link rel="alternate" hreflang="zh-CN" href={abs(localize("zh-cn", path))} />
          <link rel="alternate" hreflang="en" href={abs(localize("en", path))} />
          <link rel="alternate" hreflang="x-default" href={abs(localize("zh-cn", path))} />
        </>
      )
    }
    <link rel="alternate" type="application/atom+xml" title="WebMux releases" href="/changelog.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="WebMux" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt ?? title} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[lang === "en" ? "zh-cn" : "en"]} />
    <meta name="twitter:card" content="summary_large_image" />
    <HeadCommon />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(site)} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only z-50 rounded-md bg-primary px-4 py-2 font-semibold text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-4" href="#main">{t.skip}</a>
    <Header lang={lang} path={path} active={active} installHref={installHref} altPath={single ? "/" : undefined} />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
