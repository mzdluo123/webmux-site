{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "svelte": true,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".astro/",
    ".cache/",
    ".wrangler/",
    ".lighthouseci/",
    "pnpm-lock.yaml",
    "src/content/docs/",
    "public/",
    "src/assets/",
    "src/data/*.json",
    "src/styles/design-tokens.css",
    "src/lib/components/ui/"
  ]
}
